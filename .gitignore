# ==========================================
# FUNewsManagementSystem - Root .gitignore
# ==========================================

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/
bin/

# Backend (Maven & Java)
backend/target/
backend/*.log
backend/.mvn/timing.properties
backend/.flattened-pom.xml

# Frontend (Node & Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Logs & Temp
*.log
logs/
temp/
tmp/
